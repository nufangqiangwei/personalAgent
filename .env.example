# Personal-Agent 本机配置示例
# 复制为 .env（或直接设置环境变量）后按需填写。
# 真实密钥只能来自环境变量或 Windows 凭据存储，禁止提交、禁止写入日志或测试夹具。

# --- 运行模式 ---
# mock：默认，完全离线，使用固定观测；live：仅在 T021 接入门禁通过并显式授权后可用。
PERSONAL_AGENT_MODE=mock
PERSONAL_AGENT_HOST=127.0.0.1
PERSONAL_AGENT_PORT=8000

# 数据目录。留空使用 %LOCALAPPDATA%\Personal-Agent。
# PERSONAL_AGENT_DATA_DIR=C:\Users\<you>\AppData\Local\Personal-Agent

# 仅开发：允许的前端 Origin（生产同源，不需要此项）。
PERSONAL_AGENT_DEV_ORIGIN=http://127.0.0.1:5173

# --- 模型（仅 live 模式读取，mock 模式忽略）---
# 由模型网关持有并在调用供应商时读取；不得传给 runtime 或写入数据库。
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# PERSONAL_AGENT_MODEL=deepseek-v4-flash

# --- 搜索（仅 live 模式读取）---
# BRAVE_SEARCH_API_KEY=

# --- 测试 ---
# live 测试同时要求 --live 与 PERSONAL_AGENT_LIVE=1，并在用户显式授权后运行。
# PERSONAL_AGENT_LIVE=0

# E2E 使用独立临时工作区，禁止指向日常数据目录。
# PERSONAL_AGENT_E2E_PORT=8123
# PERSONAL_AGENT_E2E_DATA_DIR=
